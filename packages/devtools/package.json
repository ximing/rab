{
  "name": "@rabjs/devtools",
  "version": "9.2.1",
  "description": "RABjs 开发调试工具，通过 CDP 协议暴露容器树状态",
  "main": "lib/main.cjs",
  "module": "lib/main.js",
  "types": "lib/main.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "import": "./lib/main.js",
      "require": "./lib/main.cjs"
    }
  },
  "scripts": {
    "build": "tsx build.config.ts",
    "dev": "tsx build.config.ts --watch",
    "clean": "rm -rf lib build dist coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "reactive",
    "state",
    "devtools",
    "cdp",
    "debug"
  ],
  "author": "ximing",
  "license": "MIT",
  "peerDependencies": {
    "@rabjs/service": "workspace:*"
  },
  "devDependencies": {
    "@rabjs/service": "workspace:*",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsconfig": "workspace:*",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/**/*",
    "build/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@rabjs/shared": "workspace:*"
  }
}
