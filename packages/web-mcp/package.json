{
  "name": "@rabjs/web-mcp",
  "version": "9.3.2",
  "description": "Web MCP 集成 - 将 @rabjs/service 的 Service 系统与 WebMCP 协议桥接",
  "main": "lib/main.cjs",
  "module": "lib/main.js",
  "types": "lib/main.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "import": "./lib/main.js",
      "require": "./lib/main.cjs"
    }
  },
  "scripts": {
    "build": "tsx build.config.ts",
    "dev": "tsx build.config.ts --watch",
    "clean": "rm -rf lib build dist coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "mcp",
    "web",
    "reactive",
    "state",
    "webmcp"
  ],
  "author": "ximing",
  "license": "MIT",
  "peerDependencies": {
    "@rabjs/service": "workspace:*",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@rabjs/shared": "workspace:*",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@rabjs/service": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12",
    "tsconfig": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "zod": "^3.22.0"
  },
  "files": [
    "lib/**/*",
    "build/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
